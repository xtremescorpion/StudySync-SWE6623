# Template for server/.env. Copy it there and set MONGODB_URI.
# server/.env is listed in .gitignore, so the password is never committed.

# Database: MongoDB, cloud-hosted.
# Atlas provides this string under Connect > Drivers > Node.js.
# Replace <password> with the real password and put the database name
# (studysync) after the final slash.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studysync

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Security
JWT_SECRET=studysync-dev-secret-change-me
JWT_EXPIRES_IN=2h

# Optional: mail server for invitation and reminder emails.
# Without SMTP_HOST the messages are recorded but not delivered.
# SMTP_HOST=smtp.gmail.com
